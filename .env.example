# Nothing reads this file automatically. Set TICKETS_ENV_FILE to an absolute path
# to a private copy, or set the process environment directly. Never commit keys.
TICKETS_TRANSLATION=off
TICKETS_COPILOT=off
# TICKETS_DB=C:/absolute/workspace/tickets.db
# TICKETS_NOTES=C:/absolute/workspace/notes
# TICKETS_REPOSITORIES=C:/absolute/private/repositories.json
# Enable only the feature you intend to use. Keys alone do not enable calls.
# ZAI_API_KEY=replace-me
# GLM_API_KEY=legacy-alias-for-ZAI_API_KEY
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
TICKETS_COPILOT_MODEL=glm-5.3
# KIMI_API_KEY=replace-me
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-k3
