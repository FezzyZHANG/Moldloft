# Optional private configuration; point MOLDLOFT_ENV_FILE at an explicit copy if needed.
# Process environment variables always take precedence.

# Absolute path to the single Moldloft SQLite database.
# MOLDLOFT_DB=C:/path/to/moldloft.db

# Absolute path to a JSON file mapping logical repo IDs to absolute Git checkout paths.
# MOLDLOFT_REPOS=C:/path/to/repositories.json

# Optional comma-separated extra host:port values allowed on MCP Streamable HTTP when using --listen.
# MOLDLOFT_MCP_ALLOWED_HOSTS=
