include AGENTS.md CLAUDE.md CHANGELOG.md DESIGN.md DEPLOYMENT.md MCP.md
include .env.example
recursive-include docs *.md
recursive-include config *.example.json
recursive-include src/tickets/templates *.html
recursive-include src/tickets/static *.js *.css *.md
recursive-include tests *.py *.mjs *.json
recursive-include tools/agent_hooks *.py
prune data
prune notes
prune review
prune workspace
prune organization
global-exclude __pycache__ *.pyc *.db *.sqlite3 .env
